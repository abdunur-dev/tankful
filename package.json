{
  "name": "tankful",
  "version": "0.1.1",
  "description": "An eve extension that gives an agent a token fuel tank so it can see its budget and adapt instead of being cut off.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdunur-dev/tankful.git"
  },
  "keywords": [
    "eve",
    "eve-extension",
    "ai-agents",
    "token-budget",
    "loop-detection"
  ],
  "type": "module",
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.mjs"
    },
    "./guard": {
      "types": "./dist/extension/lib/guard.d.ts",
      "default": "./dist/extension/lib/guard.mjs"
    }
  },
  "scripts": {
    "build": "eve extension build",
    "prepare": "eve extension build",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.x",
    "eve": "1.5.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "eve": "*"
  }
,
  "engines": {
    "node": ">=24"
  }
}
